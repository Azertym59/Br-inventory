rules_version = '2';

// Règles de sécurité BR Inventaire
// Trois niveaux :
//  - sans compte (connexion anonyme Firebase, nom saisi sur le téléphone) :
//    consulter une fiche, inventorier, signaler un problème (à valider par un admin)
//  - technicien (compte) : + créer du matériel, prendre en charge et clôturer les réparations
//  - admin (compte) : + valider les signalements, re-dispatcher le matériel entre parcs,
//    assigner les tickets, gérer lieux / catégories / modèles / équipe
// L'historique (/evenements) est en ajout seul : personne ne peut le modifier.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAnon() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function me() { return get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data; }
    function isMember() {
      return signedIn() && !isAnon()
        && exists(/databases/$(database)/documents/utilisateurs/$(request.auth.uid))
        && me().actif == true;
    }
    function isAdmin() { return isMember() && me().role == 'admin'; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /utilisateurs/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      // Création de compte équipe : toujours en technicien
      allow create: if signedIn() && !isAnon() && request.auth.uid == uid
        && request.resource.data.role == 'technicien'
        && request.resource.data.actif == true;
      allow update: if isAdmin()
        || (isMember() && request.auth.uid == uid && changed().hasOnly(['nom']));
      allow delete: if isAdmin();
    }

    match /lieux/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /modeles/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /materiel/{ref} {
      allow read: if signedIn();
      allow create: if isMember();
      // Changer de parc = admin uniquement. Sans compte : seulement la trace d'inventaire.
      allow update: if isAdmin()
        || (isMember() && !changed().hasAny(['lieuId', 'lieuNom']))
        || (signedIn() && changed().hasOnly(['dernierInventaire']));
      allow delete: if isAdmin();
    }

    match /evenements/{id} {
      allow read: if isMember();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Signalements sans compte, en attente de validation
    match /signalements/{id} {
      allow create: if signedIn() && request.resource.data.declarant.uid == request.auth.uid
        && request.resource.data.statut == 'a_valider';
      allow read: if isMember();
      allow update, delete: if isAdmin();
    }

    // Matériel trouvé dans un autre parc lors d'un inventaire
    match /propositions/{id} {
      allow create: if signedIn() && request.resource.data.par.uid == request.auth.uid
        && request.resource.data.statut == 'a_valider';
      allow read: if isMember();
      allow update, delete: if isAdmin();
    }

    match /tickets/{id} {
      allow read: if isMember();
      allow create: if isAdmin() || (isMember() && request.resource.data.signalePar.uid == request.auth.uid);
      allow update: if isMember();
      allow delete: if isAdmin();
    }

    match /inventaires/{id} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /compteurs/{id} {
      allow read, write: if isMember();
    }
  }
}
